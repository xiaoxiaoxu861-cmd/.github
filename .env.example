# MiniMall 服务地址
MINIMALL_BASE_URL=http://localhost:3000
MINIMALL_TIMEOUT=5
MINIMALL_PRODUCT_ID=3

# 测试账号配置，请在本地 .env 中填写真实测试账号，禁止提交真实手机号和密码
MINIMALL_VALID_PHONE=<your_test_phone>
MINIMALL_VALID_PASSWORD=<your_test_password>

# MySQL 数据库配置，请在本地 .env 中填写真实连接信息，禁止提交真实密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<your_database_name>
DB_USER=<your_database_user>
DB_PASSWORD=<your_database_password_or_empty>

# 后端本地运行配置示例
PORT=3000
JWT_SECRET=<your_local_jwt_secret>
